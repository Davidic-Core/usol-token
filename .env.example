# Optional settings for the website server and its read-only balance proxy.
# No deployment, transaction, keypair, or metadata-upload settings are supported.
PORT=3000
HOST=0.0.0.0

# Optional read-only RPC timeout in milliseconds (default 15000).
USOL_RPC_TIMEOUT_MS=15000

# Server-side Solana Mainnet endpoint for the read-only balance proxy
# (POST /api/rpc). Set one of these in the server environment only — never in
# web/ files, HTML, or committed configuration, so the key is never served to
# the browser.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# HELIUS_API_KEY=YOUR_HELIUS_KEY
