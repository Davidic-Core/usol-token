# UnitedSolana (USOL) — optional runtime settings
#
# The wallet page needs no configuration at all: the Phantom connection happens
# entirely inside the visitor's browser, so there is no API key, RPC endpoint or
# client secret to declare. PORT and HOST are optional and already defaulted in
# web/server.js.
#
# NEVER put wallet material in this file (or in any environment file): no seed
# phrase, no private key, no keypair JSON. The application only ever receives a
# public wallet address from Phantom, in the browser.

PORT=3000
HOST=0.0.0.0

# --- Mainnet deployment scripts (all optional) ---------------------------------
#
# Keypair paths. Defaults live outside the repository under
# ~/.config/unitedsolana/mainnet/. Point these at the exported keypair files
# instead of moving them into the project.
# USOL_FEE_PAYER_KEYPAIR=/secure/path/fee-payer.json
# USOL_AUTHORITY_KEYPAIR=/secure/path/authority.json
#
# The scripts always use the official Mainnet RPC (https, exact origin). This
# override exists only for a local validator dry run that never submits; any
# other network is refused, and a local endpoint is refused with --execute.
# USOL_RPC_URL=http://127.0.0.1:8899
#
# RPC request timeout in milliseconds (default 15000).
# USOL_RPC_TIMEOUT_MS=15000
#
# Irys storage endpoint used for the logo and metadata upload (Mainnet default).
# USOL_IRYS_ADDRESS=https://node1.irys.xyz
